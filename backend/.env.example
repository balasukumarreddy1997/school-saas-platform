# Copy this file to .env and update values

# Application
APP_NAME="School SaaS Platform"
DEBUG=true

# Database (for local development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_saas

# JWT Authentication (CHANGE IN PRODUCTION!)
JWT_SECRET=dev-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudflare R2 Storage (optional for local dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=school-content

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
